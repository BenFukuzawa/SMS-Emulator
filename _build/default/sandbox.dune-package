(lang dune 3.22)
(name sandbox)
(sections (lib .) (libexec .) (doc ../../doc/sandbox))
(files
 (lib
  (META
   dune-package
   hello/hello.ml
   hello/hello.mli
   hello/sandbox_hello.a
   hello/sandbox_hello.cma
   hello/sandbox_hello.cmi
   hello/sandbox_hello.cms
   hello/sandbox_hello.cmsi
   hello/sandbox_hello.cmt
   hello/sandbox_hello.cmti
   hello/sandbox_hello.cmx
   hello/sandbox_hello.cmxa
   hello/sandbox_hello.ml
   hello/sandbox_hello.mli
   hello/sandbox_hello__.cmi
   hello/sandbox_hello__.cms
   hello/sandbox_hello__.cmt
   hello/sandbox_hello__.cmx
   hello/sandbox_hello__.ml
   hello/sandbox_hello__Hello.cmi
   hello/sandbox_hello__Hello.cms
   hello/sandbox_hello__Hello.cmsi
   hello/sandbox_hello__Hello.cmt
   hello/sandbox_hello__Hello.cmti
   hello/sandbox_hello__Hello.cmx
   opam))
 (libexec (hello/sandbox_hello.cmxs))
 (doc (README.md odoc-config.sexp)))
(library
 (name sandbox.hello)
 (kind normal)
 (archives (byte hello/sandbox_hello.cma) (native hello/sandbox_hello.cmxa))
 (plugins (byte hello/sandbox_hello.cma) (native hello/sandbox_hello.cmxs))
 (native_archives hello/sandbox_hello.a)
 (requires
  core
  ppx_compare.runtime-lib
  ppx_here.runtime-lib
  basement
  ppx_sexp_conv.runtime-lib
  sexplib0
  ppx_assert.runtime-lib
  ppx_enumerate.runtime-lib
  ppx_hash.runtime-lib
  ppx_bench.runtime-lib
  ppx_bench.config
  bin_prot
  ppx_inline_test.config
  ppx_inline_test.runtime-lib
  ppx_expect.runtime
  ppx_expect.config
  fieldslib
  ppx_string.runtime
  ppx_log.types
  ppx_log.syntax
  ppx_module_timer.runtime
  ppx_portable.runtime
  base_quickcheck.ppx_quickcheck.runtime
  base_quickcheck
  base
  ppx_stable_witness.runtime
  ppx_typed_fields.typed_fields_lib
  ppx_typed_fields.typed_variants_lib
  sexplib
  typerep
  variantslib)
 (main_module_name Sandbox_hello)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name sandbox_hello__)
     (visibility public)
     (kind alias)
     (source
      (path Sandbox_hello__)
      (impl (path hello/sandbox_hello__.ml-gen))))
    (name Sandbox_hello)
    (modules
     (module
      (obj_name sandbox_hello__Hello)
      (visibility public)
      (source
       (path Hello)
       (intf (path hello/hello.mli))
       (impl (path hello/hello.ml))))
     (module
      (obj_name sandbox_hello)
      (visibility public)
      (source
       (path Sandbox_hello)
       (intf (path hello/sandbox_hello.mli))
       (impl (path hello/sandbox_hello.ml))))))
   (wrapped true))))
